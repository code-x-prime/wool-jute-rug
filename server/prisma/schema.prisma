  NETBANKING
  WALLET
  UPI
  EMI
  OTHER
}

enum OrderPaymentMethod {
  CASH
  RAZORPAY
  PHONEPE
  PAYPAL
  PAYONEER
}

enum PaymentGatewayType {
  RAZORPAY
  PHONEPE
  PAYPAL
  PAYONEER
}

enum PaymentMode {
  TEST
  LIVE
}

enum PaymentStatus {
  PENDING
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum ShipmentStatus {
  PROCESSING
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum ContactSubmissionStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

enum PartnerPaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum ReferralStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Banner {
  id           String   @id @default(uuid())
  title        String?
  subtitle     String?
  link         String   @default("/products")
  desktopImage String
  mobileImage  String
  position     Int      @default(0)
  isPublished  Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, isActive, position])
}

// Shoppable Video Carousel - horizontal carousel with product-linked media
model ShoppableVideoCarousel {
  id          String                        @id @default(uuid())
  name        String                        @default("Shoppable Video")
  autoScroll  Boolean                       @default(true)
  isActive    Boolean                       @default(true)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  items       ShoppableVideoCarouselItem[]

  @@index([isActive])
}

model ShoppableVideoCarouselItem {
  id              String                  @id @default(uuid())
  carouselId      String
  mediaType       String                  // UPLOAD | YOUTUBE | INSTAGRAM
  mediaUrl        String?                 // For UPLOAD: S3 URL; for YOUTUBE/INSTAGRAM: embed URL
  thumbnailUrl    String?                 // Product thumbnail for bottom bar
  textOverlay     String?                 // Optional text overlay (e.g. "Let's unbox it")
  viewCount       Int                     @default(0)
  productId       String?
  displayOrder    Int                     @default(0)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  carousel        ShoppableVideoCarousel  @relation(fields: [carouselId], references: [id], onDelete: Cascade)
  product         Product?                @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([carouselId, displayOrder])
  @@index([productId])
}

// Flash Sale model

model FlashSale {
  id                 String             @id @default(uuid())
  name               String
  startTime          DateTime
  endTime            DateTime
  discountPercentage Float
  maxQuantity        Int?
  soldCount          Int                @default(0)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  products           FlashSaleProduct[]
}

model FlashSaleProduct {
  id          String    @id @default(uuid())
  flashSaleId String
  productId   String
  flashSale   FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([flashSaleId, productId])
}

model Referral {
  id           String         @id @default(uuid())
  referrerId   String // User who referred
  referredId   String // User who was referred
  code         String         @unique
  rewardAmount Decimal?       @db.Decimal(10, 2)
  status       ReferralStatus @default(PENDING)
  orderId      String?        @unique // Order that triggered the reward
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  referrer     User           @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred     User           @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)
  order        Order?         @relation(fields: [orderId], references: [id])

  @@unique([referrerId, referredId])
  @@index([referrerId])
  @@index([referredId])
  @@index([status])
}

model ReturnRequest {
  id                      String       @id @default(uuid())
  orderId                 String
  orderItemId             String
  userId                  String
  reason                  String
  customReason            String? // If user selects "Other"
  status                  ReturnStatus @default(PENDING)
  images                  String[]
  adminNotes              String? // Admin can add notes
  processedAt             DateTime?
  processedBy             String? // Admin ID who processed
  shiprocketReturnOrderId String?
  shiprocketReturnStatus  String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  order                   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem               OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  user                    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
}

model ReturnSettings {
  id               String   @id @default(uuid())
  isEnabled        Boolean  @default(false)
  returnWindowDays Int      @default(7) // Days after delivery to allow returns
  updatedAt        DateTime @updatedAt
  updatedBy        String?

  @@unique([id])
}

model RecentlyViewed {
  id        String   @id @default(uuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())

  @@unique([userId, productId])
}

model PaymentSettings {
  id              String   @id @default(uuid())
  cashEnabled     Boolean  @default(true)
  razorpayEnabled Boolean  @default(false)
  codCharge       Decimal  @default(0) @db.Decimal(10, 2)
  updatedAt       DateTime @updatedAt
  updatedBy       String?

  @@unique([id])
}

// -----------------------
// Price Visibility Settings
// -----------------------
model PriceVisibilitySetting {
  id                  String   @id @default(uuid())
  hidePricesForGuests Boolean  @default(false) // If true, hide prices for non-logged-in users
  isActive            Boolean  @default(true)
  updatedAt           DateTime @updatedAt
  updatedBy           String?

  @@unique([id])
}

// -----------------------
// MOQ (Minimum Order Quantity) & Bulk Pricing
// -----------------------
enum MOQScope {
  GLOBAL
  PRODUCT
  VARIANT
}

model MOQSetting {
  id          String          @id @default(uuid())
  scope       MOQScope
  productId   String?
  variantId   String?
  minQuantity Int
  isActive    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  product     Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([scope, productId, variantId])
  @@index([scope])
  @@index([productId])
  @@index([variantId])
}

model PricingSlab {
  id        String          @id @default(uuid())
  productId String?
  variantId String?
  minQty    Int
  maxQty    Int?
  price     Decimal         @db.Decimal(10, 2)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  product   Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@index([productId, minQty])
  @@index([variantId, minQty])
}

// -----------------------
// Payment Gateway Settings (Multi-Merchant)
// -----------------------
model PaymentGatewaySetting {
  id       String             @id @default(uuid())
  userId   String
  gateway  PaymentGatewayType
  isActive Boolean            @default(true)

  // Razorpay Keys
  razorpayKeyId         String?
  razorpayKeySecret     String? // Encrypted
  razorpayWebhookSecret String? // Encrypted

  // PhonePe Keys
  phonepeMerchantId String?
  phonepeSaltKey    String? // Encrypted
  phonepeSaltIndex  String?

  mode PaymentMode @default(TEST)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gateway])
  @@index([userId])
  @@index([gateway, isActive])
}

model PhonePeTransaction {
  id            String   @id @default(uuid())
  transactionId String   @unique
  userId        String
  orderId       String?
  amount        Int // Amount in paise
  orderData     String // JSON string of order data
  status        String   @default("PENDING") // PENDING, SUCCESS, FAILED
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([userId])
  @@index([status])
}

// -----------------------
// Shiprocket Integration
// -----------------------
model ShiprocketSettings {
  id          String    @id @default(uuid())
  isEnabled   Boolean   @default(false)
  email       String?
  password    String? // Encrypted
  token       String?
  tokenExpiry DateTime?

  // Default shipping dimensions (fallback values)
  defaultLength  Float @default(10) // cm
  defaultBreadth Float @default(10) // cm
  defaultHeight  Float @default(10) // cm
  defaultWeight  Float @default(0.5) // kg

  // Manual Shipping Charges
  shippingCharge        Decimal @default(0) @db.Decimal(10, 2)
  freeShippingThreshold Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([id])
}

model ShiprocketPickupAddress {
  id                 String   @id @default(uuid())
  nickname           String   @default("Primary Warehouse")
  name               String
  email              String
  phone              String
  address            String
  address2           String?
  city               String
  state              String
  country            String   @default("India")
  pincode            String
  isDefault          Boolean  @default(true)
  shiprocketPickupId Int? // Shiprocket's pickup location ID after sync
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isDefault])
}

// -----------------------
// Marketing Configuration
// -----------------------
model MarketingConfig {
  id String @id @default(uuid())

  // Email (Brevo) Configuration
  emailEnabled Boolean @default(false)
  smtpHost     String?
  smtpPort     Int?    @default(587)
  smtpUser     String?
  smtpPassword String? // Encrypted
  fromEmail    String?
  fromName     String?

  // WhatsApp (AiSensy) Configuration
  whatsappEnabled     Boolean @default(false)
  aisensyApiKey       String? // Encrypted
  aisensyCampaignName String?
  whatsappSenderName  String  @default("Desire Div")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model MarketingCampaign {
  id              String         @id @default(uuid())
  type            MarketingType
  name            String
  subject         String? // For email
  content         String         @db.Text
  targetAudience  TargetAudience
  status          CampaignStatus @default(DRAFT)
  totalRecipients Int            @default(0)
  successCount    Int            @default(0)
  failureCount    Int            @default(0)
  scheduledAt     DateTime?
  sentAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdBy       String?
  logs            MarketingLog[]
}

model MarketingLog {
  id         String            @id @default(uuid())
  campaignId String
  userId     String?
  recipient  String // email or phone
  status     LogStatus
  error      String?
  sentAt     DateTime          @default(now())
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([status])
}

enum MarketingType {
  EMAIL
  WHATSAPP
}

enum TargetAudience {
  ALL_USERS
  NEW_USERS
  OLD_USERS
  ABANDONED_CART
  REPEAT_BUYERS
  TOP_BUYERS
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  FAILED
}

enum LogStatus {
  PENDING
  SUCCESS
  FAILED
}

// Tawk.to Live Chat Configuration
model TawkToConfig {
  id         String   @id @default(uuid())
  propertyId String? // Tawk.to Property ID
  widgetId   String? // Tawk.to Widget ID
  isEnabled  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// OAuth Provider Settings (Google, Facebook, Twitter) - Admin configurable
model OAuthProviderSetting {
  id           String   @id @default(uuid())
  provider     String   @unique // "google" | "facebook" | "twitter"
  isEnabled    Boolean  @default(false)
  clientId     String?  // Public - no encryption needed
  clientSecret String?  // Encrypted in DB
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// -----------------------
// Site Settings (Company Details + Razorpay + Shiprocket)
// -----------------------
model SiteSettings {
  id                  String    @id @default(cuid())
  siteName            String    @default("My Store")
  siteDescription     String?
  siteEmail           String?
  sitePhone           String?
  siteAddress         String?
  siteCity            String?
  siteState           String?
  sitePincode         String?
  siteCountry         String    @default("India")
  siteGSTIN           String?
  sitePAN             String?
  siteLogo            String?
  siteFavicon         String?
  orderPrefix         String    @default("ORD")
  orderEmailFooter    String?
  razorpayKeyId       String?
  razorpayKeySecret   String?
  razorpayEnabled     Boolean   @default(false)
  // PayPal
  paypalClientId      String?
  paypalClientSecret  String?
  paypalEnabled       Boolean   @default(false)
  paypalMode          String    @default("sandbox")  // "sandbox" | "live"
  // Payoneer
  payoneerApiKey      String?
  payoneerProgramId   String?
  payoneerEnabled     Boolean   @default(false)
  // Easyship (international shipping)
  easyshipApiKey      String?
  easyshipEnabled     Boolean   @default(false)
  easyshipAccountId   String?
  // Shiprocket (domestic shipping)
  shiprocketEmail     String?
  shiprocketPassword  String?
  shiprocketEnabled   Boolean   @default(false)
  shiprocketToken     String?
  shiprocketTokenExpiry DateTime?
  usdExchangeRate     Float     @default(90)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// Media storage: Digital Ocean, Cloudflare R2, or AWS S3 - only one active at a time
model StorageConfig {
  id                    String   @id @default(cuid())
  activeProvider        String?  // "DIGITAL_OCEAN" | "CLOUDFLARE_R2" | "AWS_S3" - only one active
  uploadFolder          String   @default("ecom-uploads")
  // Digital Ocean Spaces
  spacesAccessKey       String?
  spacesSecretKey       String?  // Encrypted
  spacesBucket          String?
  spacesRegion          String?
  spacesEndpoint        String?
  spacesCdnUrl          String?
  // Cloudflare R2
  r2AccountId           String?
  r2AccessKeyId         String?
  r2SecretAccessKey     String?  // Encrypted
  r2BucketName          String?
  r2PublicUrl           String?
  // AWS S3
  s3AccessKeyId         String?
  s3SecretAccessKey     String?  // Encrypted
  s3BucketName          String?
  s3Region              String?
  s3Endpoint            String?  // Optional custom endpoint
  s3PublicUrl           String?  // Optional custom public URL
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// -----------------------
// Add-on Services
// -----------------------
model AddonService {
  id          String         @id @default(uuid())
  name        String
  description String?
  price       Decimal        @db.Decimal(10, 2)
  icon        String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  products    ProductAddon[]
  cartAddons  CartItemAddon[]
  orderAddons OrderItemAddon[]
}

model ProductAddon {
  id             String       @id @default(uuid())
  productId      String
  addonServiceId String
  createdAt      DateTime     @default(now())
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  addonService   AddonService @relation(fields: [addonServiceId], references: [id], onDelete: Cascade)

  @@unique([productId, addonServiceId])
}

model CartItemAddon {
  id             String       @id @default(uuid())
  cartItemId     String
  addonServiceId String
  price          Decimal      @db.Decimal(10, 2)
  createdAt      DateTime     @default(now())
  cartItem       CartItem     @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  addonService   AddonService @relation(fields: [addonServiceId], references: [id], onDelete: Cascade)

  @@unique([cartItemId, addonServiceId])
}

model OrderItemAddon {
  id             String       @id @default(uuid())
  orderItemId    String
  addonServiceId String
  name           String
  price          Decimal      @db.Decimal(10, 2)
  createdAt      DateTime     @default(now())
  orderItem      OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addonService   AddonService @relation(fields: [addonServiceId], references: [id], onDelete: Cascade)
}
